{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=crudworks.db"
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:5173"
  },
  "Jwt": {
    "Issuer": "CrudWorks",
    "Audience": "CrudWorks.Client",
    "ExpiryMinutes": 60
  }
}
